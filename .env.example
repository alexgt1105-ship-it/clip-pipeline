ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# A SECOND Telegram bot, not the one motivation-shorts uses. Two pollers on the same
# token steal each other's taps. Make one in @BotFather, message it once, paste here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# claude-opus-5 (~15c per hour of source) or claude-haiku-4-5 (~3c).
CLIP_MODEL=claude-opus-5

YOUTUBE_CLIENT_SECRET_PATH=youtube_client_secret.json
YOUTUBE_TOKEN_PATH=youtube_token.json
YOUTUBE_PRIVACY_STATUS=private

# blur = 16:9 over a blurred fill, nothing cropped. crop = full-bleed 9:16.
DEFAULT_LAYOUT=blur
MIN_CLIP_SECONDS=20
MAX_CLIP_SECONDS=75

# Only set (chrome/safari/firefox) if YouTube starts refusing downloads.
COOKIES_FROM_BROWSER=

# Keep the multi-hundred-MB source videos after clipping. Off by default.
KEEP_SOURCES=
